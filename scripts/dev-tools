#!/usr/bin/env bash
set -euo pipefail

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"

internal_python='python@3.14.8'

# Minimal startup preference read when the pinned Python is not available yet.
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
if [[ ${EUID} -eq 0 && -n ${SUDO_USER:-} && -z ${XDG_CONFIG_HOME:-} ]]; then
  caller_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
  [[ -z "$caller_home" ]] || config_home="$caller_home/.config"
fi
config_file="${DEV_TOOLS_CONFIG:-$config_home/dev-tools/config.toml}"
tokens=("$@")
for ((index=0; index<${#tokens[@]}; index++)); do
  [[ ${tokens[index]} != -- ]] || break
  if [[ ${tokens[index]} == --config && $((index+1)) -lt ${#tokens[@]} ]]; then
    ((index+=1)); config_file="${tokens[index]}"
  elif [[ ${tokens[index]} == --config=* ]]; then
    config_file="${tokens[index]#--config=}"
  fi
done
startup_language=zh
language_pattern="^[[:space:]]*language[[:space:]]*=[[:space:]]*[\"'](zh|en)[\"'][[:space:]]*(#.*)?$"
if [[ -r "$config_file" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ ! "$line" =~ ^[[:space:]]*\[ ]] || break
    if [[ "$line" =~ $language_pattern ]]; then startup_language="${BASH_REMATCH[1]}"; break; fi
  done < "$config_file"
fi
if [[ ${DEV_TOOLS_TRANSPORT_LANGUAGE:-} == en || ${DEV_TOOLS_TRANSPORT_LANGUAGE:-} == zh ]]; then
  startup_language="$DEV_TOOLS_TRANSPORT_LANGUAGE"
fi
startup_error() {
  if [[ "$startup_language" == en ]]; then printf '%s\n' "$2" >&2;
  else printf '%s\n' "$1" >&2; fi
}

get_internal_python() {
  if [[ -f "$repo_root/.host-python" ]]; then
    local installed_python
    installed_python=$(cat "$repo_root/.host-python")
    [[ -x "$installed_python" ]] || {
      startup_error '已安装的 dev-tools 宿主缺失；请重新运行 scripts/install.sh。' 'Installed dev-tools host is missing; rerun scripts/install.sh.'
      return 1
    }
    printf '%s\n' "$installed_python"
    return 0
  fi
  command -v mise >/dev/null 2>&1 || {
    startup_error 'mise 不可用；请安装 mise 后重新运行 scripts/install.sh。' 'mise is unavailable; rerun scripts/install.sh after installing mise.'
    return 1
  }
  local python_root
  python_root="$(mise --no-config -C "$repo_root" where "$internal_python" 2>/dev/null)" || {
    startup_error 'dev-tools Python 3.14.8 缺失；请重新运行 scripts/install.sh。' 'dev-tools Python 3.14.8 is missing; rerun scripts/install.sh.'
    return 1
  }
  local python="$python_root/bin/python3"
  [[ -x "$python" ]] || {
    startup_error 'dev-tools Python 可执行文件缺失；请重新运行 scripts/install.sh。' 'dev-tools Python executable is missing; rerun scripts/install.sh.'
    return 1
  }
  printf '%s\n' "$python"
}

if [[ $# -eq 0 ]]; then
  set -- help
fi
python="$(get_internal_python)"
export PYTHONPATH="$repo_root/src"
export PYTHONUTF8=1
exec "$python" -P -m dev_tools.cli "$@"

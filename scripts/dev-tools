#!/usr/bin/env bash
set -euo pipefail

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"

internal_python='python@3.14.8'

get_internal_python() {
  command -v mise >/dev/null 2>&1 || {
    printf 'mise is unavailable; rerun scripts/install.sh after installing mise.\n' >&2
    return 1
  }
  local python_root
  python_root="$(mise where "$internal_python" 2>/dev/null)" || {
    printf 'dev-tools Python 3.14.8 is missing; rerun scripts/install.sh.\n' >&2
    return 1
  }
  local python="$python_root/bin/python3"
  [[ -x "$python" ]] || {
    printf 'dev-tools Python executable is missing; rerun scripts/install.sh.\n' >&2
    return 1
  }
  printf '%s\n' "$python"
}

show_help() {
  cat <<'EOF'
dev-tools - 按项目发现并准备当前 WSL 的开发工具版本

帮助：
  dev-tools help
  dev-tools --version
  dev-tools project --help
  dev-tools project <命令> --help

环境检查：
  dev-tools report [--json]
  dev-tools sysinfo [--json]
  dev-tools status
  dev-tools doctor

项目工作流：
  dev-tools project scan [PATH]
  dev-tools project scan [PATH] --json
  dev-tools project init [PATH]
  dev-tools project init [PATH] --dry-run
  dev-tools project prepare [PATH]
  dev-tools project prepare [PATH] --dry-run

dev-tools 不维护或安装 Java、Node、Python 等全局默认版本。
需要同时检查 Windows 和 WSL 时，请从 PowerShell 运行 status 或 doctor。
EOF
}

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command_name" in
  help|-h|--help)
    show_help
    ;;
  version|-V|--version)
    python="$(get_internal_python)"
    export PYTHONPATH="$repo_root/src"
    exec "$python" -m dev_tools.cli --version
    ;;
  sysinfo|report|project)
    python="$(get_internal_python)"
    export PYTHONPATH="$repo_root/src"
    exec "$python" -m dev_tools.cli "$command_name" "$@"
    ;;
  status)
    command -v mise >/dev/null 2>&1 || {
      printf '当前 WSL 未安装 mise。\n' >&2
      exit 1
    }
    mise --version
    "$(get_internal_python)" --version
    ;;
  doctor)
    command -v mise >/dev/null 2>&1 || {
      printf '当前 WSL 未安装 mise。\n' >&2
      exit 1
    }
    mise doctor
    ;;
  *)
    printf '未知命令：%s\n\n' "$command_name" >&2
    show_help >&2
    exit 2
    ;;
esac
